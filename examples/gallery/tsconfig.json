{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "preserve",
    "moduleDetection": "force",
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@vibecn/*": ["./node_modules/@usevibejs/vibecn/registry/ui/*"],
      "__VIBECN_UTILS__": ["./node_modules/@usevibejs/vibecn/registry/lib/utils.ts"],
      "__VIBECN_LIB__/*": ["./node_modules/@usevibejs/vibecn/registry/lib/*"]
    }
  },
  "contentMappers": [{ "package": "@usevibejs/language-tools", "extensions": [".vibe"] }],
  "include": ["src"]
}
