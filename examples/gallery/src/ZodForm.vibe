<script setup lang="ts">
import { ref } from '@usevibejs/ui';
import { useField, useForm } from '@usevibejs/form';
import * as z from 'zod';

const schema = z.object({ email: z.email(), age: z.number().min(18) });
const saved = ref('');
const form = useForm({
  defaultValues: { email: '', age: 18 },
  validators: { onChange: schema },
  onSubmit: ({ value }) => {
    saved.value = value.email;
  },
});
const email = useField(form, 'email');
const age = useField(form, 'age');
</script>

<template>
  <form class="grid max-w-sm gap-3" data-example="zod" @submit="form.submit">
    <label for="zod-email">Email</label>
    <input id="zod-email" name="email" v-model="email.value" @blur="email.handleBlur" :aria-invalid="email.invalid || undefined" />
    <p role="alert">{{ email.error }}</p>
    <label for="zod-age">Age</label>
    <input id="zod-age" name="age" type="number" v-model.number="age.value" />
    <p role="alert">{{ age.error }}</p>
    <button type="submit" :disabled="!form.isValid">Save</button>
    <p>{{ saved }}</p>
  </form>
</template>
