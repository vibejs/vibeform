<script setup lang="ts">
import { ref } from '@usevibejs/ui';
import { useField, useForm } from '@usevibejs/form';

const result = ref('');
const form = useForm({
  defaultValues: { email: '', password: '' },
  onSubmit: ({ value }) => {
    result.value = value.email;
  },
});
const email = useField(form, 'email', {
  validators: {
    onBlur: ({ value }) => (value.includes('@') ? undefined : 'Enter an email'),
  },
});
const password = useField(form, 'password', {
  validators: {
    onBlur: ({ value }) => (value.length >= 8 ? undefined : 'Use at least 8 characters'),
  },
});
</script>

<template>
  <form class="grid max-w-sm gap-3" data-example="login" @submit="form.submit">
    <label for="login-email">Email</label>
    <input id="login-email" name="email" type="email" autocomplete="username" v-model="email.value" @blur="email.handleBlur" :aria-invalid="email.invalid || undefined" aria-describedby="login-email-error" />
    <p id="login-email-error" role="alert">{{ email.error }}</p>
    <label for="login-password">Password</label>
    <input id="login-password" name="password" type="password" autocomplete="current-password" v-model="password.value" @blur="password.handleBlur" :aria-invalid="password.invalid || undefined" />
    <p role="alert">{{ password.error }}</p>
    <button type="submit" :disabled="form.isSubmitting || !form.canSubmit">Sign in</button>
    <p data-result>{{ result }}</p>
  </form>
</template>
