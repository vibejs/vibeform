<script setup lang="ts">
import { useField, useForm } from '@usevibejs/form';
import { applyServerErrors, clearServerErrors } from '@usevibejs/form/contract';

const form = useForm({
  defaultValues: { email: 'ada@example.com' },
  onSubmit: () => {
    clearServerErrors(form, ['email']);
    applyServerErrors(form, { fields: { email: ['This email is already registered'] } });
  },
});
const email = useField(form, 'email');
</script>

<template>
  <form class="grid max-w-sm gap-3" data-example="server" @submit="form.submit">
    <label for="server-email">Email</label>
    <input id="server-email" name="email" v-model="email.value" @blur="email.handleBlur" :aria-invalid="email.invalid || undefined" aria-describedby="server-email-error" />
    <p id="server-email-error" role="alert">{{ email.error }}</p>
    <button type="submit">Create</button>
  </form>
</template>
