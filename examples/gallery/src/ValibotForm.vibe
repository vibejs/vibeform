<script setup lang="ts">
import { useField, useForm } from '@usevibejs/form';
import * as v from 'valibot';

const schema = v.object({
  email: v.pipe(v.string(), v.email()),
  age: v.pipe(v.number(), v.minValue(18)),
});
const form = useForm({
  defaultValues: { email: '', age: 18 },
  validators: { onChange: schema },
});
const email = useField(form, 'email');
const age = useField(form, 'age');
</script>

<template>
  <form class="grid max-w-sm gap-3" data-example="valibot" @submit="form.submit">
    <label for="valibot-email">Email</label>
    <input id="valibot-email" name="email" v-model="email.value" @blur="email.handleBlur" :aria-invalid="email.invalid || undefined" />
    <p role="alert">{{ email.error }}</p>
    <label for="valibot-age">Age</label>
    <input id="valibot-age" name="age" type="number" v-model.number="age.value" />
    <button type="submit">Save</button>
  </form>
</template>
